# Set these in Coolify's environment editor, per application. Nothing here is
# read at build time; every value is runtime-only. This file documents the
# variables, it is not loaded by anything.
#
# Never tick Coolify's "Shown once" on any of these. It is a one-way lock: the
# value reads back as null in both the UI and the API afterwards, and the only
# write that unlocks it wipes the value.

# --- Required, one per connector ----------------------------------------------
# Connector token of the tunnel, from Cloudflare Zero Trust > Networks >
# Tunnels. Without it the app refuses to render, by design.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional -----------------------------------------------------------------
# auto, quic or http2. Use http2 where quic is blocked or throttled.
TUNNEL_TRANSPORT_PROTOCOL=auto

# Metrics and /ready listener. Normally left unset: cloudflared defaults to
# 127.0.0.1:20241 and moves up the range if that port is occupied, which a fixed
# value would prevent.
# TUNNEL_METRICS=

# --- Image pin ----------------------------------------------------------------
# Owned by .github/workflows/upstream-update.yml. Set it on a single Coolify app
# to hold or roll back that one connector without touching git.
# CLOUDFLARED_TAG=2026.9.0
